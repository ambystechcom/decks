---
// Overrides Axo's <Eyebrow>. "03 · Label" and "Regla 3 · Label" are split so the pointer can be
// fuchsia and the label stays quiet. Anything else renders as one plain span, like the built-in.
const raw = typeof Axo.children === 'string' ? Axo.children : null;
const m = raw ? raw.match(/^\s*((?:[A-Za-zÁÉÍÓÚáéíóú]+\s)?\d+)\s*[·:]\s*(.+?)\s*$/) : null;
---

{m ? (
  <span class="module-number"><span class="n">{m[1]}</span><span class="l">{m[2]}</span></span>
) : (
  <span class="module-number"><slot /></span>
)}
