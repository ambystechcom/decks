---
// A sequence diagram drawn as inline SVG, so every message can travel when the slide arrives:
// its arrow draws from the sender, a packet runs along it, then the label lands.
//
//   <Sequence actors={[
//     { id: 'P',  name: 'Aficionado',      kind: 'person', icon: 'user' },
//     { id: 'AG', name: 'Agente',          kind: 'agent',  icon: 'robot' },
//     { id: 'B',  name: 'Boletera',        kind: 'system', icon: 'ticket', sub: 'servidor MCP' },
//   ]}>
//     <Msg from="P" to="AG" say>"Recolección mañana antes de las 2"</Msg> a person speaking
//     <Msg from="AG" to="C">cotizar_envio(Apodaca, Nuevo Laredo, 3)</Msg> a call (mono)
//     <Msg from="C" to="AG" reply focus>Q-17 · 11:00, 13:00</Msg>        a reply; `focus` is the point
//     <Msg from="S" to="AG" lost>(timeout)</Msg>                         the answer never arrives
//     <Note over="S">La recolección sí se creó</Note>                    over one lane, or "AG,S"
//   </Sequence>
//
// Colour follows the deck: fuchsia = a person, cyan = the agent, white = your system.
// `numbered` puts the step number at each message's origin.

const { actors = [], numbered = false, row = 50, pad = 120 } = Axo.props;
expect(actors.length >= 2 && actors.length <= 4, `<Sequence> takes 2–4 actors (got ${actors.length}).`);

const ICONS = { user: '\uf007', robot: '\uf544', stethoscope: '\uf0f1', server: '\uf233', truck: '\uf0d1', ticket: '\uf145' };
const W = 1180, HEAD = 84;
// header text baselines: icon, name, then the optional sub line just above the rule
// one baseline for every name, raised when any lane has a sub line
const hasSub = actors.some((a) => a.sub);
const nameY = () => HEAD - (hasSub ? 30 : 12);
const lane = {};
actors.forEach((a, i) => { lane[a.id] = pad + (i * (W - 2 * pad)) / (actors.length - 1); });

const text = (c) => (typeof c === 'string' ? c : Array.isArray(c) ? c.join('') : String(c ?? ''));
const items = toChildArray(Axo.children).map((c, i) => ({ ...c.props, body: text(c.props?.children), i }));
for (const it of items) {
  if (it.over) {
    for (const id of it.over.split(',')) expect(id in lane, `<Note over="${it.over}">: no actor "${id}".`);
  } else {
    expect(it.from in lane && it.to in lane, `<Msg from="${it.from}" to="${it.to}">: unknown actor.`);
  }
}

const y0 = HEAD + 40;
const H = y0 + (items.length - 1) * row + 34;
let n = 0;
const rows = items.map((it) => {
  const y = y0 + it.i * row;
  if (it.over) {
    const xs = it.over.split(',').map((id) => lane[id]);
    const w = Math.max(it.body.length * 9.6 + 48, xs.length > 1 ? Math.max(...xs) - Math.min(...xs) + 90 : 0);
    const cx = (Math.min(...xs) + Math.max(...xs)) / 2;
    return { note: true, ...it, y, x: cx - w / 2, w, cx };
  }
  const x1 = lane[it.from], x2 = lane[it.to], dir = x2 > x1 ? 1 : -1;
  const a = x1 + dir * (numbered ? 14 : 4), b = x2 - dir * (it.lost ? 16 : 9);
  const kinds = [it.from, it.to].map((id) => actors.find((ac) => ac.id === id)?.kind);
  const tone = it.lost ? 'lost' : it.focus ? 'focus' : it.say || kinds.includes('person') ? 'say' : it.reply ? 'reply' : 'call';
  return { ...it, y, x1, x2, dir, a, b, tone, n: ++n, dashed: !!(it.reply || it.lost) };
});
---

<svg class="sq" viewBox={`0 0 ${W} ${H}`} role="img"
     aria-label={items.map((it) => (it.over ? it.body : `${it.from} → ${it.to}: ${it.body}`)).join('. ')}>
  {actors.map((a) => (
    <g class={`sq-actor sq-k-${a.kind ?? 'system'}`}>
      <line x1={lane[a.id]} y1={HEAD} x2={lane[a.id]} y2={H - 6} class="sq-life" />
      <rect x={lane[a.id] - 110} y={HEAD - 2} width="220" height="2" class="sq-rule" />
      {a.icon && <text x={lane[a.id]} y={nameY(a) - 28} text-anchor="middle" class="sq-ico">{ICONS[a.icon] ?? ''}</text>}
      <text x={lane[a.id]} y={nameY(a)} text-anchor="middle" class="sq-name">{a.name}</text>
      {a.sub && <text x={lane[a.id]} y={HEAD - 10} text-anchor="middle" class="sq-sub">{a.sub}</text>}
    </g>
  ))}

  {rows.map((r) =>
    r.note ? (
      <g class={`sq-step sq-note${r.ok ? ' sq-note-ok' : ''}`} style={`--i:${r.i}`}>
        <rect x={r.x} y={r.y - 17} width={r.w} height="34" class="sq-note-box" />
        <rect x={r.x} y={r.y - 17} width="3" height="34" class="sq-note-bar" />
        <text x={r.cx} y={r.y + 6} text-anchor="middle" class="sq-note-t">{r.body}</text>
      </g>
    ) : (
      <g class={`sq-step sq-msg sq-t-${r.tone}`} style={`--i:${r.i};--dx:${r.b - r.a}px;--o:${r.dir > 0 ? 'left' : 'right'}`}>
        <g class="sq-draw">
          <line x1={r.a} y1={r.y} x2={r.b} y2={r.y} class:list={['sq-line', r.dashed && 'sq-dashed']} />
        </g>
        {r.lost ? (
          <path d={`M ${r.b - 6} ${r.y - 6} L ${r.b + 6} ${r.y + 6} M ${r.b + 6} ${r.y - 6} L ${r.b - 6} ${r.y + 6}`} class="sq-x" />
        ) : (
          <polygon points={`${r.x2},${r.y} ${r.x2 - r.dir * 11},${r.y - 5.5} ${r.x2 - r.dir * 11},${r.y + 5.5}`} class="sq-head" />
        )}
        <circle cx={r.a} cy={r.y} r="4.5" class="sq-packet" />
        <text x={(r.x1 + r.x2) / 2} y={r.y - 11} text-anchor="middle" class="sq-label">{r.body}</text>
        {numbered && (
          <g class="sq-num">
            <circle cx={r.x1} cy={r.y} r="11" />
            <text x={r.x1} y={r.y + 4.5} text-anchor="middle">{r.n}</text>
          </g>
        )}
      </g>
    )
  )}
</svg>
