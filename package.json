{
  "name": "decks",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Ambystech public slide decks: the decks.ambystech.io listing (Astro) plus every Axo deck, built into dist/ for GitHub Pages.",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build.mjs --skip-decks",
    "decks": "node scripts/build.mjs --decks-only",
    "preview": "node scripts/serve.mjs dist",
    "astro": "astro"
  },
  "dependencies": {
    "@ambystech/ui": "github:ambystechcom/ambystech-ui#v0.2.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  },
  "engines": { "node": ">=22" }
}
