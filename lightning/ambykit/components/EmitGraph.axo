---
// One neutral source fanning out to every assistant's native files. Inline SVG so the links
// draw themselves in order when the slide arrives and then carry a current.
//
//   <EmitGraph files={['.amby/prompts/', '.amby/roles/']}>
//     <Target path=".claude/commands/amby/">Claude Code</Target>
//   </EmitGraph>

const { title = 'Neutral source', files = [], sync = 'ambykit sync' } = Axo.props;
const targets = toChildArray(Axo.children).map((t) => ({
  path: t.props?.path ?? '',
  name: typeof t.props?.children === 'string' ? t.props.children : '',
}));
expect(targets.length >= 2 && targets.length <= 8, `<EmitGraph> takes 2–8 <Target>s (got ${targets.length}).`);

const W = 1180, H = 40 + targets.length * 50;
const src = { x: 0, y: H / 2 - 55, w: 250, h: 110 };
const tx = 620, tw = 560, th = 40, gap = 50;
const top = H / 2 - ((targets.length - 1) * gap) / 2;
const outs = targets.map((t, i) => ({ ...t, x: tx, y: top + i * gap - th / 2, cy: top + i * gap, i }));
const x0 = src.x + src.w, y0 = H / 2;
const links = outs.map((o) => `M ${x0} ${y0} C ${x0 + 170} ${y0}, ${o.x - 170} ${o.cy}, ${o.x} ${o.cy}`);
---

<svg class="eg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${title} emitted to ${targets.map((t) => t.name).join(', ')}`}>
  <g class="eg-src">
    <rect x={src.x} y={src.y} width={src.w} height={src.h} rx="4" class="eg-box eg-box-src" />
    <text x={src.x + 18} y={src.y + 30} class="eg-t">{title}</text>
    {files.map((f, i) => <text x={src.x + 18} y={src.y + 56 + i * 20} class="eg-f">{f}</text>)}
  </g>

  {links.map((d, i) => (
    <g class="eg-link" style={`--i:${i}`}>
      <path d={d} class="eg-line" pathLength="1" />
      <path d={d} class="eg-current" />
    </g>
  ))}

  <g class="eg-sync">
    <rect x={x0 + 120} y={y0 - 16} width={190} height={32} rx="16" class="eg-pill" />
    <text x={x0 + 215} y={y0 + 5} text-anchor="middle" class="eg-sync-t">{sync}</text>
  </g>

  {outs.map((o) => (
    <g class="eg-out" style={`--i:${o.i}`}>
      <rect x={o.x} y={o.y} width={tw} height={th} rx="4" class="eg-box eg-box-out" />
      <text x={o.x + 16} y={o.cy + 6} class="eg-p">{o.path}</text>
      <text x={o.x + tw - 16} y={o.cy + 6} text-anchor="end" class="eg-n">{o.name}</text>
    </g>
  ))}
</svg>
